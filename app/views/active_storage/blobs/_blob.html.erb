<figure class="attachment attachment--<%= blob.representable? ? "preview" : "file" %> attachment--<%= blob.filename.extension %>">
  <% if blob.image? %>
    <% if blob.byte_size <= CommentImagePolicy::AUTO_DISPLAY_LIMIT %>
      <%= image_tag blob, alt: blob.filename.to_s, class: "comment-attachment-image" %>
    <% else %>
      <button type="button" class="comment-image-reveal" data-controller="reveal-image" data-reveal-image-url-value="<%= url_for(blob) %>" data-reveal-image-alt-value="<%= blob.filename %>">
        Show <%= blob.content_type == "image/gif" ? "GIF" : "image" %> (<%= number_to_human_size blob.byte_size %>)
      </button>
    <% end %>
  <% elsif blob.representable? %>
    <%= image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [ 800, 600 ] : [ 1024, 768 ]) %>
  <% end %>
</figure>
