<div class="hidden min-w-0 max-w-full items-center gap-3 sm:flex">
  <details data-close-on-outside class="relative hidden min-w-0 max-w-full sm:block">
    <summary class="flex h-11 w-40 cursor-pointer list-none items-center gap-2 rounded-md border border-transparent px-3 text-sm font-medium text-neutral-100 hover:border-pine-500 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500 [&::-webkit-details-marker]:hidden">
      <% if Current.user.avatar.attached? %>
        <%= image_tag Current.user.avatar, alt: "", class: "size-6 shrink-0 rounded-full object-cover" %>
      <% else %>
        <%= icon "user-circle", variant: "outline", class: "size-6 shrink-0", "aria-hidden": true %>
      <% end %>
      <span class="min-w-0 flex-1 truncate" title="<%= Current.user.name %>"><%= Current.user.name %></span>
      <%= icon "chevron-down", variant: "outline", class: "size-4 shrink-0", "aria-hidden": true %>
    </summary>
    <div class="absolute right-0 top-full z-20 mt-2 w-56 max-w-[calc(100vw-2.5rem)] rounded-md border border-pine-600 bg-black p-2 text-sm text-neutral-100 shadow-lg">
      <%= link_to "My Profile", profile_path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
      <%= link_to "My Picks", my_picks_path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
      <%= button_to "Sign Out", session_path, method: :delete, class: "min-h-11 w-full rounded-md px-3 text-left font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
    </div>
  </details>
</div>
<details data-close-on-outside class="sm:hidden">
  <summary class="flex size-11 cursor-pointer items-center justify-center rounded-md text-sm font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500">
    <%= icon "menu-2", variant: "outline" %>
    <span class="sr-only">Open navigation menu</span>
  </summary>
  <div class="absolute inset-x-0 top-full z-20 w-full bg-black text-neutral-100">
    <div class="mx-auto max-w-6xl px-5 py-2">
      <nav aria-label="Mobile navigation">
        <% { "Picks" => picks_path, "Games" => games_path, "Leaders" => leaders_path, "Legends" => legends_path }.each do |title, path| %>
          <%= link_to title, path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
        <% end %>
      </nav>
      </br>
      <hr class="border-neutral-700">
      </br>
      <div class="flex min-h-11 min-w-0 items-center gap-2 px-3 text-sm font-medium">
        <% if Current.user.avatar.attached? %>
          <%= image_tag Current.user.avatar, alt: "", class: "size-6 shrink-0 rounded-full object-cover" %>
        <% else %>
          <%= icon "user-circle", variant: "outline", class: "size-6 shrink-0", "aria-hidden": true %>
        <% end %>
        <span class="min-w-0 flex-1 truncate" title="<%= Current.user.name %>"><%= Current.user.name %></span>
      </div>
      <%= link_to "My Profile", profile_path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
      <%= link_to "My Picks", my_picks_path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
      <%= button_to "Sign Out", session_path, method: :delete, form_class: "mt-1", class: "min-h-11 w-full rounded-md px-3 text-left text-sm font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500" %>
    </div>
  </div>
</details>
