<header class="relative bg-black bg-linear-to-b from-neutral-800 to-black text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
    <div class="flex items-center gap-8">
      <%= link_to "Mouthguard", root_path, class: "text-xl font-bold tracking-tight text-brass-300 hover:text-brass-200 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300" %>
      <nav aria-label="Main navigation" class="hidden sm:block">
        <%= link_to "Dashboard", root_path, class: "font-medium text-neutral-100 hover:text-brass-300 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300" %>
      </nav>
    </div>
    <div class="hidden items-center gap-3 sm:flex">
      <%= render "layouts/theme_controls" %>
      <%= button_to "Sign out", session_path, method: :delete, form_class: "hidden sm:block", class: "rounded-md border border-brass-400 px-3 py-2 text-sm font-medium text-brass-200 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300" %>
    </div>
    <details class="sm:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-md px-3 text-sm font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300">
        <%= icon "menu-2", variant: "outline" %>
        <span class="sr-only">Open navigation menu</span>
      </summary>
      <div class="absolute inset-x-0 top-full z-20 w-full bg-black text-neutral-100">
        <div class="mx-auto max-w-6xl px-5 py-2">
          <nav aria-label="Mobile navigation">
            <%= link_to "Dashboard", root_path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300" %>
          </nav>
          <div class="mt-1">
            <%= render "layouts/theme_controls" %>
          </div>
          <%= button_to "Sign out", session_path, method: :delete, form_class: "mt-1", class: "min-h-11 w-full rounded-md border border-brass-400 px-3 text-left text-sm font-medium text-brass-200 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300" %>
        </div>
      </div>
    </details>
  </div>
</header>
