<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
    <div class="flex items-center gap-8">
      <%= link_to "Mouthguard", root_path, class: "text-xl font-bold tracking-tight text-gray-900" %>
      <nav aria-label="Main navigation" class="hidden sm:block">
        <%= link_to "Dashboard", root_path, class: "font-medium text-gray-700 hover:text-gray-900" %>
      </nav>
    </div>
    <%= button_to "Sign out", session_path, method: :delete, form_class: "hidden sm:block", class: "rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    <details class="relative sm:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-md px-3 text-sm font-medium text-gray-700 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
        <%= icon "menu-2", variant: "outline" %>
        <span class="sr-only">Open navigation menu</span>
      </summary>
      <div class="absolute right-0 top-full z-10 mt-2 w-48 rounded-md border border-gray-200 bg-white p-2 shadow-lg">
        <nav aria-label="Mobile navigation">
          <%= link_to "Dashboard", root_path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-gray-700 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
        </nav>
        <%= button_to "Sign out", session_path, method: :delete, form_class: "mt-1", class: "min-h-11 w-full rounded-md border border-gray-300 px-3 text-left text-sm font-medium text-gray-700 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
      </div>
    </details>
  </div>
</header>
