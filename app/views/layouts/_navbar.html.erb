<header class="relative bg-black bg-linear-to-b from-neutral-800 to-black text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
    <div class="flex items-center gap-8">
      <%= link_to "Mouthguard", root_path, class: "text-xl font-bold tracking-tight text-neutral-100 hover:text-pine-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-400" %>
      <nav aria-label="Main navigation" class="hidden sm:flex items-center gap-4">
        <% {
            "Games" => games_path,
            "Picks" => picks_path,
            "Leaders" => leaders_path,
            "Legends" => legends_path
          }.each do |title, path|
        %>
          <%= link_to title, path, class: "flex min-h-11 items-center font-medium text-neutral-100 hover:text-pine-400 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-400" %>
        <% end %>
      </nav>
    </div>

    <%= render "layouts/menu" %>
  </div>
</header>
