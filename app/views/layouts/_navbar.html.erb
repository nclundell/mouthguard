<header class="relative bg-black bg-linear-to-b from-neutral-800 to-black text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
    <div class="flex items-center gap-8">
      <%= link_to "Mouthguard", root_path, class: "text-xl font-bold tracking-tight text-green-300 hover:text-green-200 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300" %>
      <nav aria-label="Main navigation" class="hidden sm:flex items-center gap-4">
        <% { "Picks" => picks_path, "Games" => games_path, "Leaders" => leaders_path, "Legends" => legends_path }.each do |title, path| %>
          <%= link_to title, path, class: "flex min-h-11 items-center font-medium text-neutral-100 hover:text-green-300 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300" %>
        <% end %>
      </nav>
    </div>
    <div class="hidden min-w-0 max-w-full items-center gap-3 sm:flex">
      <details data-close-on-outside class="relative hidden min-w-0 max-w-full sm:block">
        <summary class="flex min-h-11 min-w-0 max-w-full cursor-pointer list-none items-center gap-2 rounded-md border border-green-300 px-3 py-2 text-sm font-medium text-green-200 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300 [&::-webkit-details-marker]:hidden">
          <% account_name = Current.user.display_name.presence || [Current.user.first_name, Current.user.last_name].compact_blank.join(" ").presence || Current.user.email_address %>
          <span class="min-w-0 max-w-48 truncate" title="<%= account_name %>"><%= account_name %></span>
          <%= icon "chevron-down", variant: "outline", class: "size-4 shrink-0", "aria-hidden": true %>
        </summary>
        <div class="absolute right-0 top-full z-20 mt-2 w-56 max-w-[calc(100vw-2.5rem)] rounded-md border border-green-300 bg-black p-2 text-sm text-neutral-100 shadow-lg">
          <p class="break-all px-3 py-2 text-neutral-300"><%= Current.user.email_address %></p>
          <%= render "layouts/theme_controls" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "min-h-11 w-full rounded-md px-3 text-left font-medium text-green-200 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300" %>
        </div>
      </details>
    </div>
    <details data-close-on-outside class="sm:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-md px-3 text-sm font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300">
        <%= icon "menu-2", variant: "outline" %>
        <span class="sr-only">Open navigation menu</span>
      </summary>
      <div class="absolute inset-x-0 top-full z-20 w-full bg-black text-neutral-100">
        <div class="mx-auto max-w-6xl px-5 py-2">
          <nav aria-label="Mobile navigation">
            <% { "Picks" => picks_path, "Games" => games_path, "Leaders" => leaders_path, "Legends" => legends_path }.each do |title, path| %>
              <%= link_to title, path, class: "flex min-h-11 items-center rounded-md px-3 font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300" %>
            <% end %>
          </nav>
          <div class="mt-1">
            <%= render "layouts/theme_controls" %>
          </div>
          <%= button_to "Sign out", session_path, method: :delete, form_class: "mt-1", class: "min-h-11 w-full rounded-md border border-green-300 px-3 text-left text-sm font-medium text-green-200 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300" %>
        </div>
      </div>
    </details>
  </div>
</header>
