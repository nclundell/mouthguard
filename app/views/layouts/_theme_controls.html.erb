<div class="flex flex-wrap items-center gap-2 text-sm">
  <button type="button" data-theme-toggle aria-label="Switch to dark mode" class="min-h-11 rounded-md bg-brass-300 px-3 font-medium text-neutral-950 hover:bg-brass-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300">Dark mode</button>
  <button type="button" data-theme-system hidden class="min-h-11 rounded-md px-2 font-medium text-brass-200 underline hover:text-brass-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-300">Use system theme</button>
</div>
