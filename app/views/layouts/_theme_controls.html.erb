<button type="button" role="switch" data-theme-toggle aria-label="Dark Mode" title="Toggle dark mode" aria-checked="false" class="flex size-11 shrink-0 items-center justify-center rounded-md text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500">
  <%= icon "moon", variant: "outline", class: "size-6 text-pine-400", data: { theme_icon: "off" }, "aria-hidden": true %>
  <%= icon "sun", variant: "outline", class: "size-6 text-pine-400", data: { theme_icon: "on" }, "aria-hidden": true, hidden: true %>
</button>
