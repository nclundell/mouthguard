<button type="button" role="switch" data-theme-toggle aria-label="Dark Mode" aria-checked="false" class="flex min-h-11 w-full items-center justify-between gap-2 rounded-md px-3 text-sm font-medium text-neutral-100 hover:bg-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-500">
  <span>Dark Mode</span>
  <%= icon "toggle-left", variant: "outline", class: "size-6 shrink-0 text-pine-400", data: { theme_icon: "off" }, "aria-hidden": true %>
  <%= icon "toggle-right", variant: "outline", class: "size-6 shrink-0 text-pine-400", data: { theme_icon: "on" }, "aria-hidden": true, hidden: true %>
</button>
