<div class="mx-auto max-w-2xl">
  <h1 class="border-l-4 border-pine-950 pl-4 text-3xl font-bold tracking-tight text-neutral-900 dark:border-pine-500 dark:text-neutral-100">Edit Profile</h1>

  <% if @user.errors.any? %>
    <div role="alert" class="mt-6 rounded-md border border-red-700 bg-red-50 px-4 py-3 text-red-800 dark:bg-red-950 dark:text-red-200">
      <p class="font-medium">Please correct the following errors:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: profile_path, method: :patch, multipart: true, class: "mt-8" do |form| %>
    <div class="divide-y divide-pine-950/20 rounded-lg border border-pine-950/30 bg-white px-5 dark:divide-pine-500/40 dark:border-pine-500/60 dark:bg-neutral-900">
      <% { email_address: "Email address", first_name: "First name", last_name: "Last name", display_name: "Display name" }.each do |field, label| %>
        <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
          <%= form.label field, label, class: "font-medium text-neutral-600 dark:text-neutral-300" %>
          <div class="mt-1 break-words sm:col-span-2 sm:mt-0">
            <% if field == :email_address %>
              <%= form.email_field field, required: true, autocomplete: "email", class: "block w-full min-w-0 border-0 bg-transparent p-0 text-base leading-6 text-neutral-900 shadow-[inset_0_-1px_0_0_#142f25] focus:outline-2 focus:outline-pine-950 dark:text-neutral-100 dark:shadow-[inset_0_-1px_0_0_#437d68] dark:focus:outline-pine-400" %>
            <% else %>
              <%= form.text_field field, class: "block w-full min-w-0 border-0 bg-transparent p-0 text-base leading-6 text-neutral-900 shadow-[inset_0_-1px_0_0_#142f25] focus:outline-2 focus:outline-pine-950 dark:text-neutral-100 dark:shadow-[inset_0_-1px_0_0_#437d68] dark:focus:outline-pine-400" %>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
        <%= form.label :avatar, "Avatar", class: "font-medium text-neutral-600 dark:text-neutral-300" %>
        <div class="mt-1 break-words sm:col-span-2 sm:mt-0">
          <% if @avatar || @user.avatar.attached? %>
            <%= image_tag @avatar || @user.avatar, alt: "Current avatar", class: "mb-3 size-20 rounded-full object-cover" %>
          <% else %>
            <%= icon "user-circle", variant: "outline", class: "mb-3 size-20 text-neutral-600 dark:text-neutral-300", "aria-hidden": true %>
          <% end %>
          <%= form.file_field :avatar, accept: "image/*", class: "block w-full text-sm text-neutral-900 dark:text-neutral-100" %>
          <% if @avatar || @user.avatar.attached? %>
            <div class="mt-3 flex items-center gap-2">
              <%= form.check_box :remove_avatar %>
              <%= form.label :remove_avatar, "Remove avatar", class: "text-sm text-neutral-900 dark:text-neutral-100" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <fieldset class="mt-6 divide-y divide-pine-950/20 rounded-lg border border-pine-950/30 bg-white px-5 dark:divide-pine-500/40 dark:border-pine-500/60 dark:bg-neutral-900">
      <legend class="px-2 font-medium text-neutral-900 dark:text-neutral-100">Change password (optional)</legend>
      <% { current_password: [ "Current password", "current-password" ], password: [ "New password", "new-password" ], password_confirmation: [ "Confirm new password", "new-password" ] }.each do |field, (label, autocomplete)| %>
        <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
          <%= form.label field, label, class: "font-medium text-neutral-600 dark:text-neutral-300" %>
          <div class="mt-1 break-words sm:col-span-2 sm:mt-0">
            <%= form.password_field field, value: "", autocomplete: autocomplete, class: "block w-full min-w-0 border-0 bg-transparent p-0 text-base leading-6 text-neutral-900 shadow-[inset_0_-1px_0_0_#142f25] focus:outline-2 focus:outline-pine-950 dark:text-neutral-100 dark:shadow-[inset_0_-1px_0_0_#437d68] dark:focus:outline-pine-400" %>
          </div>
        </div>
      <% end %>
    </fieldset>
    <div class="mt-6 flex flex-wrap items-center gap-5">
      <%= form.submit "Save", class: "min-h-11 cursor-pointer rounded-md bg-pine-900 px-4 font-medium text-white hover:bg-pine-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-950 dark:bg-pine-700 dark:text-neutral-100 dark:hover:bg-pine-600 dark:focus-visible:outline-pine-400" %>
      <%= link_to "Cancel", profile_path, class: "text-pine-900 underline hover:no-underline focus-visible:outline-2 focus-visible:outline-pine-950 dark:text-neutral-100 dark:focus-visible:outline-pine-400" %>
    </div>
  <% end %>
</div>
