<aside data-picks-side="<%= side %>" aria-label="<%= side.capitalize %> picks" class="hidden lg:block">
  <% if !visible %>
    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300">Picks hidden until kickoff</p>
  <% elsif names.empty? %>
    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300">No picks yet</p>
  <% else %>
    <ul class="mt-3 space-y-3">
      <% names.each do |name| %>
        <%= render "pick_note", name: name %>
      <% end %>
    </ul>
  <% end %>
</aside>
