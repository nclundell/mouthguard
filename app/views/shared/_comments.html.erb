<section id="comments" data-comments class="mt-10 rounded-2xl border border-pine-600/30 bg-white p-5 shadow-sm dark:border-pine-500/40 dark:bg-neutral-800" aria-labelledby="comments-heading">
  <%= turbo_stream_from stream_name if page == 1 %>

  <% if flash[:notice] %>
    <p role="status" class="mt-4 text-sm text-pine-800 dark:text-pine-400"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert] %>
    <p role="alert" class="mt-4 text-sm text-red-700 dark:text-red-400"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with model: comment, url: form_url, class: "space-y-3" do |form| %>
    <%= form.label :body, "Your comment", class: "sr-only" %>
    <% if comment.errors.any? %>
      <p id="comment-errors" role="alert" class="text-sm text-red-700 dark:text-red-400"><%= comment.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form.rich_text_area :body, aria: ( { describedby: "comment-errors", invalid: true } if comment.errors.any? ), class: "block w-full rounded-lg border border-pine-600/40 bg-white text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100" %>
    <%= form.submit "Post comment", class: "rounded-lg bg-pine-900 px-4 py-2 font-semibold text-white hover:bg-pine-800 dark:bg-pine-700" %>
  <% end %>

  <%= render "shared/comments_feed", comments: comments, page: page, has_older_comments: has_older_comments, page_path: page_path %>
</section>
