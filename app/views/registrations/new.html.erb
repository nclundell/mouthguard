<div class="mx-auto md:w-2/3 w-full">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-800 font-medium rounded-lg inline-block dark:bg-red-950 dark:text-red-200" role="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Sign up</h1>

  <% if @user.errors.any? %>
    <div role="alert" class="mt-6 rounded-md border border-red-700 bg-red-50 px-4 py-3 text-red-800 dark:bg-red-950 dark:text-red-200">
      <p class="font-medium">Please correct the following errors:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :email_address, "Email address", class: "font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "block shadow-sm rounded-md border border-pine-950 bg-white text-neutral-900 px-3 py-2 mt-2 w-full dark:border-neutral-400 dark:bg-neutral-800 dark:text-neutral-100" %>
    </div>

    <div class="my-5">
      <%= form.label :display_name, "Display name (optional)", class: "font-medium" %>
      <%= form.text_field :display_name, autocomplete: "nickname", class: "block shadow-sm rounded-md border border-pine-950 bg-white text-neutral-900 px-3 py-2 mt-2 w-full dark:border-neutral-400 dark:bg-neutral-800 dark:text-neutral-100" %>
    </div>

    <div class="my-5">
      <%= form.label :password, class: "font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, value: "", class: "block shadow-sm rounded-md border border-pine-950 bg-white text-neutral-900 px-3 py-2 mt-2 w-full dark:border-neutral-400 dark:bg-neutral-800 dark:text-neutral-100" %>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, "Confirm password", class: "font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, value: "", class: "block shadow-sm rounded-md border border-pine-950 bg-white text-neutral-900 px-3 py-2 mt-2 w-full dark:border-neutral-400 dark:bg-neutral-800 dark:text-neutral-100" %>
    </div>

    <%= form.submit "Sign up", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-pine-900 hover:bg-pine-950 text-white inline-block font-medium cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-950 dark:bg-pine-700 dark:text-neutral-100 dark:hover:bg-pine-600 dark:focus-visible:outline-pine-400" %>
    <p class="mt-4"><%= link_to "Already have an account? Sign in", new_session_path, class: "text-pine-900 underline hover:no-underline dark:text-neutral-100" %></p>
  <% end %>
</div>
