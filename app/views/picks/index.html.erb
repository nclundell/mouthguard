<h1 class="border-l-4 border-pine-950 pl-4 text-3xl font-bold tracking-tight text-neutral-900 dark:border-pine-500 dark:text-neutral-100">Picks</h1>

<div data-controller="picks-filter" data-action="keydown.esc->picks-filter#close">
  <div class="mt-6 hidden gap-3 sm:flex" data-picks-filter-target="controls">
    <div class="relative min-w-0">
      <div class="flex min-w-0 items-center gap-2">
        <input id="bowl-search" type="search" autocomplete="off" placeholder="Search bowls" aria-label="Search bowls" aria-controls="bowl-options" aria-expanded="false" data-picks-filter-target="bowlSearch" data-action="input->picks-filter#search focus->picks-filter#search" class="min-w-44 w-40 max-w-full rounded border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900">
      </div>
      <div id="bowl-options" hidden data-picks-filter-target="bowlDropdown" class="absolute left-0 z-30 mt-1 w-full min-w-44 rounded border border-neutral-300 bg-white p-2 shadow-lg dark:border-neutral-600 dark:bg-neutral-900">
        <div class="max-h-60 overflow-y-auto">
          <% @bowl_titles.each do |title| %>
            <label hidden class="flex items-center gap-2 py-1 text-sm" data-picks-filter-target="bowlOption">
              <input type="checkbox" value="<%= title %>" data-action="change->picks-filter#update" class="size-4 accent-pine-700">
              <%= title %>
            </label>
          <% end %>
          <p hidden data-picks-filter-target="bowlNoMatches" class="text-sm text-neutral-500">No matching bowls</p>
        </div>
      </div>
    </div>
    <div class="relative min-w-0">
      <div class="flex min-w-0 items-center gap-2">
        <input id="user-search" type="search" autocomplete="off" placeholder="Search users" aria-label="Search users" aria-controls="user-options" aria-expanded="false" data-picks-filter-target="userSearch" data-action="input->picks-filter#search focus->picks-filter#search" class="min-w-44 w-40 max-w-full rounded border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900">
      </div>
      <div id="user-options" hidden data-picks-filter-target="userDropdown" class="absolute right-0 z-30 mt-1 w-full min-w-44 rounded border border-neutral-300 bg-white p-2 shadow-lg dark:border-neutral-600 dark:bg-neutral-900">
        <div class="max-h-60 overflow-y-auto">
          <% @users.each do |user| %>
            <label hidden class="flex items-center gap-2 py-1 text-sm" data-picks-filter-target="userOption">
              <input type="checkbox" value="<%= user.id %>" <%= "checked" if @selected_user_ids.include?(user.id.to_s) %> data-action="change->picks-filter#update" class="size-4 accent-pine-700">
              <%= @user_labels.fetch(user.id) %>
            </label>
          <% end %>
          <p hidden data-picks-filter-target="userNoMatches" class="text-sm text-neutral-500">No matching users</p>
        </div>
      </div>
    </div>
  </div>
  <p class="mt-4 hidden text-sm text-neutral-500" data-picks-filter-target="noGames">No games available</p>

<div class="mt-6 hidden sm:block" data-controller="picks-sticky-header">
<div role="region" aria-label="Picks comparison" tabindex="0" class="max-w-full overflow-x-auto rounded-lg border border-neutral-200 bg-white dark:border-neutral-700 dark:bg-neutral-800" data-picks-sticky-header-target="scroller">
  <table class="w-max min-w-full border-collapse text-left text-sm" data-picks-sticky-header-target="table">
    <thead class="bg-neutral-100 text-neutral-900 dark:bg-neutral-700 dark:text-neutral-100" data-picks-sticky-header-target="header">
      <tr>
        <th scope="col" class="sticky left-0 z-20 min-w-48 border-b border-r border-neutral-200 bg-neutral-100 px-3 py-3 dark:border-neutral-600 dark:bg-neutral-700">Game</th>
        <% @users.each do |user| %>
          <th scope="col" data-picks-filter-target="userColumn" data-user-id="<%= user.id %>" class="min-w-36 border-b border-neutral-200 px-3 py-3 font-semibold dark:border-neutral-600 <%= "hidden" unless @visible_users.include?(user) %>"><%= @user_labels.fetch(user.id) %></th>
        <% end %>
        <th scope="col" data-picks-filter-target="emptyColumn" class="border-b border-neutral-200 px-3 py-3 dark:border-neutral-600 <%= "hidden" if @visible_users.any? %>">Selections</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-neutral-200 dark:divide-neutral-700">
      <% @games.each do |game| %>
        <tr id="<%= dom_id(game) %>" data-picks-filter-target="gameRow" data-game-id="<%= game.id %>" data-bowl-title="<%= game.notes.presence || "Game" %>">
          <th scope="row" class="sticky left-0 z-10 min-w-48 border-r border-neutral-200 bg-white px-3 py-3 align-top font-semibold text-pine-950 dark:border-neutral-700 dark:bg-neutral-800 dark:text-pine-400">
            <span class="text-base"><%= game.notes.presence || "Game" %></span>
            <span class="block text-xs font-normal text-neutral-500 dark:text-neutral-400"><%= game.away&.school || "TBD" %> vs <%= game.home&.school || "TBD" %></span>
            <% if game.start %>
              <time datetime="<%= game.start.iso8601 %>" data-controller="local-time" class="block text-xs font-normal text-neutral-500 dark:text-neutral-400"><%= game.start.strftime("%b %-d, %Y at %-I:%M %p") %></time>
            <% else %>
              <span class="block text-xs font-normal text-neutral-500 dark:text-neutral-400">Kickoff TBD</span>
            <% end %>
            <% if game.tv.present? %>
              <span class="block text-xs font-normal text-neutral-500 dark:text-neutral-400"><%= game.tv %></span>
            <% end %>
          </th>
          <% if @locked_game_ids.include?(game.id) %>
            <td data-picks-filter-target="emptyCell" class="px-3 py-3 text-neutral-500 dark:text-neutral-400 <%= "hidden" if @visible_users.any? %>"><%= @users.empty? ? "No picks yet" : "No users selected" %></td>
            <% @users.each do |user| %>
              <% pick = @picks_by_game.dig(game.id, user.id) %>
              <td data-picks-filter-target="userCell" data-user-id="<%= user.id %>" class="min-w-36 px-3 py-3 align-middle <%= "hidden" unless @visible_users.include?(user) %>">
                <% unless pick&.correct.nil? %>
                  <% if pick.correct? %>
                    <span role="img" aria-label="Correct pick" class="inline-block align-middle text-green-600 dark:text-green-400"><%= icon "circle-check", variant: "filled", class: "size-4", "aria-hidden": true %></span>
                  <% else %>
                    <span role="img" aria-label="Incorrect pick" class="inline-block align-middle text-red-600 dark:text-red-400"><%= icon "circle-x", variant: "filled", class: "size-4", "aria-hidden": true %></span>
                  <% end %>
                <% end %>
                <%= pick&.team&.school.presence || "No pick" %>
              </td>
            <% end %>
          <% else %>
            <td colspan="<%= [@visible_users.size, 1].max %>" data-picks-filter-target="lockedCell" class="px-3 py-3 text-neutral-500 dark:text-neutral-400">Picks hidden until kickoff</td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
</div>

<div class="mt-6 divide-y divide-neutral-200 rounded-lg border border-neutral-200 bg-white dark:divide-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 sm:hidden">
  <% @games.each do |game| %>
    <section id="mobile_<%= dom_id(game) %>" class="px-3 py-3" data-controller="sticky-heading" data-picks-filter-target="gameCard" data-game-id="<%= game.id %>" data-bowl-title="<%= game.notes.presence || "Game" %>">
      <h2 class="picks-mobile-heading sticky z-10 -mx-3 bg-white px-3 font-semibold text-pine-950 dark:bg-neutral-800 dark:text-pine-400" data-sticky-heading-target="heading"><%= game.notes.presence || "Game" %></h2>
      <% if @locked_game_ids.include?(game.id) %>
        <p data-picks-filter-target="emptyMessage" class="mt-2 text-sm text-neutral-500 dark:text-neutral-400 <%= "hidden" if @visible_users.any? %>"><%= @users.empty? ? "No picks yet" : "No users selected" %></p>
        <% @users.each do |user| %>
          <% pick = @picks_by_game.dig(game.id, user.id) %>
          <div data-picks-filter-target="userEntry" data-user-id="<%= user.id %>" class="flex items-start justify-between gap-3 py-1.5 text-sm <%= "hidden" unless @visible_users.include?(user) %>">
            <span class="min-w-0 break-words font-medium"><%= @user_labels.fetch(user.id) %></span>
            <span class="min-w-0 break-words text-right text-neutral-600 dark:text-neutral-300">
              <% unless pick&.correct.nil? %>
                <% if pick.correct? %>
                  <span role="img" aria-label="Correct pick" class="inline-block align-middle text-green-600 dark:text-green-400"><%= icon "circle-check", variant: "filled", class: "size-4", "aria-hidden": true %></span>
                <% else %>
                  <span role="img" aria-label="Incorrect pick" class="inline-block align-middle text-red-600 dark:text-red-400"><%= icon "circle-x", variant: "filled", class: "size-4", "aria-hidden": true %></span>
                <% end %>
              <% end %>
              <%= pick&.team&.school.presence || "No pick" %>
            </span>
          </div>
        <% end %>
      <% else %>
        <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">Picks hidden until kickoff</p>
      <% end %>
    </section>
  <% end %>
</div>
</div>
