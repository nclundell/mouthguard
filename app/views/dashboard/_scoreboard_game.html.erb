<% status = if game.completed? || game.status == "completed"
              "final"
            elsif game.start && game.start <= Time.current
              "live"
            else
              "upcoming"
            end %>
<% title = game.notes.presence || "Game" %>
<%= link_to game_path(game), id: dom_id(game), data: { scoreboard_status: status, scoreboard_kickoff: game.start&.iso8601 }, class: "block min-w-0 rounded-xl border border-pine-600/30 bg-white px-4 py-3 text-neutral-900 shadow-sm transition hover:border-pine-600 hover:bg-pine-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-700 dark:border-pine-500/40 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:border-pine-400 dark:hover:bg-neutral-700 dark:focus-visible:outline-pine-400" do %>
  <h3 class="truncate text-center text-lg font-semibold text-pine-950 dark:text-pine-400" title="<%= title %>"><%= title %></h3>
  <% if status == "live" %>
    <span data-game-status class="mt-1 block text-center text-xs font-bold uppercase tracking-widest text-pine-700 dark:text-pine-400"><%= [ "Live", ("Period #{game.period}" if game.period.present?), game.clock.presence ].compact.join(" · ") %></span>
  <% elsif status == "final" %>
    <span data-game-status class="mt-1 block text-center text-xs font-bold uppercase tracking-widest text-neutral-600 dark:text-neutral-300">Final</span>
  <% elsif game.start %>
    <time data-game-status datetime="<%= game.start.iso8601 %>" data-controller="local-time" class="mt-1 block text-center text-xs text-neutral-600 dark:text-neutral-300"><%= game.start.strftime("%b %-d, %Y at %-I:%M %p") %></time>
  <% else %>
    <span data-game-status class="mt-1 block text-center text-xs text-neutral-600 dark:text-neutral-300">Kickoff TBD</span>
  <% end %>
  <div class="mt-3 flex min-w-0 items-center justify-center gap-2">
    <% [game.away, game.home].each_with_index do |team, index| %>
      <% if index == 1 %>
        <div class="min-w-0 overflow-x-auto text-center px-4">
          <%= render "games/box_score", game: game, show_partial_scores: true %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
