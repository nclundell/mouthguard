<section class="mt-8" aria-labelledby="scoreboard-heading" data-controller="game-carousel">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-pine-700 dark:text-pine-400">The bowl season</p>
      <h2 id="scoreboard-heading" class="mt-1 text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Scoreboard</h2>
      <% if @games.any? %>
        <p data-scoreboard-context data-game-carousel-target="context" class="mt-1 text-sm text-neutral-600 dark:text-neutral-300"><%= @scoreboard_context %></p>
      <% end %>
    </div>
    <%= link_to "All games →", games_path, class: "text-sm font-semibold text-pine-800 underline-offset-4 hover:underline dark:text-pine-400" %>
  </div>

  <% if @games.any? %>
    <%= turbo_stream_from "dashboard_games" %>
    <div class="relative mt-5 overflow-x-clip">
      <div data-game-carousel-target="track" role="region" aria-label="Games scoreboard" tabindex="0" class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-12 py-2 scroll-px-12 focus-visible:outline-2 focus-visible:outline-pine-700">
        <% @games.each do |game| %>
          <div data-game-carousel-target="slide" data-featured="<%= game == @featured_game %>" class="w-[min(80vw,20rem)] shrink-0 snap-start self-center rounded-xl">
            <%= render "dashboard/scoreboard_game", game: game %>
          </div>
        <% end %>
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-linear-to-r from-amber-50 to-transparent dark:from-neutral-900"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-linear-to-l from-amber-50 to-transparent dark:from-neutral-900"></div>
      <button type="button" aria-label="Previous game" data-game-carousel-control data-action="game-carousel#previous" class="hidden absolute left-1 top-1/2 z-10 size-10 -translate-y-1/2 items-center justify-center rounded-full border border-pine-600/40 bg-white text-pine-950 shadow-sm hover:bg-pine-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-700 dark:bg-neutral-800 dark:text-pine-400 dark:hover:bg-neutral-700">←</button>
      <button type="button" aria-label="Next game" data-game-carousel-control data-action="game-carousel#next" class="hidden absolute right-1 top-1/2 z-10 size-10 -translate-y-1/2 items-center justify-center rounded-full border border-pine-600/40 bg-white text-pine-950 shadow-sm hover:bg-pine-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-700 dark:bg-neutral-800 dark:text-pine-400 dark:hover:bg-neutral-700">→</button>
    </div>
  <% else %>
    <div data-scoreboard-empty class="mt-5 rounded-2xl border border-dashed border-pine-600/40 bg-white p-8 dark:bg-neutral-800">
      <p class="text-lg font-semibold">No games yet this season.</p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">Check back when the schedule is ready.</p>
      <%= link_to "Browse games →", games_path, class: "mt-4 inline-block font-semibold text-pine-800 underline-offset-4 hover:underline dark:text-pine-400" %>
    </div>
  <% end %>
</section>

<section class="mt-10" aria-labelledby="next-move-heading">
  <h2 id="next-move-heading" class="text-xl font-bold text-neutral-900 dark:text-neutral-100">Your next move</h2>
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    <%= link_to my_picks_path, class: "rounded-xl border border-pine-600/30 bg-white p-5 shadow-sm transition hover:border-pine-600 hover:bg-pine-100 focus-visible:outline-2 dark:border-pine-500/40 dark:bg-neutral-800 dark:hover:bg-neutral-700" do %>
      <span class="block font-bold text-pine-950 dark:text-pine-400">My Picks →</span>
      <span class="mt-2 block text-sm text-neutral-600 dark:text-neutral-300">See where you stand on every matchup.</span>
    <% end %>
    <%= link_to games_path, class: "rounded-xl border border-pine-600/30 bg-white p-5 shadow-sm transition hover:border-pine-600 hover:bg-pine-100 focus-visible:outline-2 dark:border-pine-500/40 dark:bg-neutral-800 dark:hover:bg-neutral-700" do %>
      <span class="block font-bold text-pine-950 dark:text-pine-400">Games →</span>
      <span class="mt-2 block text-sm text-neutral-600 dark:text-neutral-300">Explore the full bowl slate.</span>
    <% end %>
    <%= link_to leaders_path, class: "rounded-xl border border-pine-600/30 bg-white p-5 shadow-sm transition hover:border-pine-600 hover:bg-pine-100 focus-visible:outline-2 dark:border-pine-500/40 dark:bg-neutral-800 dark:hover:bg-neutral-700" do %>
      <span class="block font-bold text-pine-950 dark:text-pine-400">Leaders →</span>
      <span class="mt-2 block text-sm text-neutral-600 dark:text-neutral-300">Follow the standings as results roll in.</span>
    <% end %>
  </div>
</section>
