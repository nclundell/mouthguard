<% status = if game.completed? || game.status == "completed"
              "final"
            elsif game.start && game.start <= Time.current
              "live"
            else
              "upcoming"
            end %>
<%= link_to game_path(game), id: "threads_game_#{game.id}", data: { game_status: status }, class: "w-[min(75vw,16rem)] shrink-0 rounded-xl border px-4 py-3 shadow-sm transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-pine-700 #{status == "final" ? "border-neutral-300 bg-white opacity-60 dark:border-neutral-600 dark:bg-neutral-800" : status == "live" ? "border-pine-700 bg-pine-100 dark:border-pine-400 dark:bg-pine-950" : "border-pine-600/30 bg-white dark:border-pine-500/40 dark:bg-neutral-800"}" do %>
  <h3 class="truncate font-semibold text-pine-950 dark:text-pine-400" title="<%= game.notes.presence || "Game" %>"><%= game.notes.presence || "Game" %></h3>
  <p class="mt-1 truncate text-sm text-neutral-700 dark:text-neutral-300"><%= game.away&.school.presence || "TBD" %> vs <%= game.home&.school.presence || "TBD" %></p>
  <% if status == "live" %>
    <span class="mt-2 block text-xs font-bold uppercase tracking-wider text-pine-700 dark:text-pine-400"><%= pluralize(comment_count, "comment") %></span>
  <% elsif status == "final" %>
    <span class="mt-2 block text-xs font-bold uppercase tracking-wider text-neutral-600 dark:text-neutral-300"><%= pluralize(comment_count, "comment") %></span>
  <% else %>
    <span class="mt-2 block text-xs text-neutral-600 dark:text-neutral-300"><%= pluralize(comment_count, "comment") %></span>
  <% end %>
<% end %>
